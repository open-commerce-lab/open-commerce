#!/bin/sh
# C4 커밋 규칙: "type: subject", subject 50자 이하, 끝에 특수문자 없음
# body는 제목과 빈 줄로 구분하고 모든 줄을 불릿(- )으로 작성, 한 줄 72자 초과 시 경고
# Windows 편집기가 CRLF로 저장하는 경우를 위해 줄 끝 CR을 제거하고 검사한다
cr=$(printf '\r')
subject=$(head -n 1 "$1")
subject=${subject%"$cr"}
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

# wc -m은 로케일에 따라 바이트를 세므로, UTF-8 연속 바이트(0x80-0xBF)를 지우고 남은 바이트 수로 글자 수를 센다
char_count() {
  printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c
}

if ! printf '%s' "$subject" | grep -Eq '^(fix|feat|refactor|docs|style|test|chore): .+'; then
  echo "커밋 제목은 'type: subject' 형식이어야 합니다 (type: fix|feat|refactor|docs|style|test|chore)"
  exit 1
fi
title=$(printf '%s' "$subject" | sed -E 's/^[a-z]+: //')
if [ "$(char_count "$title")" -gt 50 ]; then
  echo "subject는 50글자 이하여야 합니다"
  exit 1
fi
if printf '%s' "$title" | grep -Eq '[.!?,;:]$'; then
  echo "subject 끝에 특수문자를 넣지 않습니다"
  exit 1
fi

# body: git이 지우는 주석 줄(#)과 verbose diff(>8 아래)는 검사하지 않는다
line_no=0
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%"$cr"}
  line_no=$((line_no + 1))
  [ "$line_no" -eq 1 ] && continue
  case "$line" in
    *'------------------------ >8 ------------------------'*) break ;;
    '#'*) continue ;;
  esac
  if [ "$line_no" -eq 2 ]; then
    if [ -n "$line" ]; then
      echo "제목과 본문 사이에는 빈 줄이 있어야 합니다"
      exit 1
    fi
    continue
  fi
  [ -z "$line" ] && continue
  # Co-Authored-By:, Signed-off-by: 같은 trailer는 불릿 검사에서 제외
  if printf '%s' "$line" | grep -Eq '^[A-Za-z][A-Za-z-]*-[Bb][Yy]: '; then
    continue
  fi
  if ! printf '%s' "$line" | grep -Eq '^[[:space:]]*- '; then
    echo "본문은 각 줄을 불릿(- )으로 작성해야 합니다: $line"
    exit 1
  fi
  if [ "$(char_count "$line")" -gt 72 ]; then
    echo "경고: 본문 한 줄은 72자 이하를 권장합니다 (${line_no}번째 줄)" >&2
  fi
done < "$1"
exit 0
